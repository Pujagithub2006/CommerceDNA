<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>io.commercedna</groupId>
    <artifactId>commercedna-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>CommerceDNA Parent</name>
    <description>AI-Native Merchant Identity &amp; Transaction Protocol for Agentic Commerce</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <springdoc.version>2.8.5</springdoc.version>
        <razorpay.version>1.4.8</razorpay.version>
    </properties>

    <modules>
        <module>commercedna-core</module>
        <module>commercedna-identity</module>
        <module>commercedna-catalog</module>
        <module>commercedna-negotiation</module>
        <module>commercedna-settlement</module>
        <module>commercedna-audit</module>
        <module>commercedna-api</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- CommerceDNA Internal Modules -->
            <dependency>
                <groupId>io.commercedna</groupId>
                <artifactId>commercedna-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.commercedna</groupId>
                <artifactId>commercedna-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.commercedna</groupId>
                <artifactId>commercedna-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.commercedna</groupId>
                <artifactId>commercedna-negotiation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.commercedna</groupId>
                <artifactId>commercedna-settlement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.commercedna</groupId>
                <artifactId>commercedna-audit</artifactId>
                <version>${project.version}</version>
            </dependency>



            <!-- Springdoc OpenAPI 3.1 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Razorpay Official Java SDK -->
            <dependency>
                <groupId>com.razorpay</groupId>
                <artifactId>razorpay-java</artifactId>
                <version>${razorpay.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>
</project>
